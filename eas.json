{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
   "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://mindery-backend-88ih.onrender.com",
        "PRIVACY_POLICY_URL": "https://mindery-legal.netlify.app/privacy/",
        "TERMS_OF_SERVICE_URL": "https://mindery-legal.netlify.app/terms/"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "PRIVACY_POLICY_URL": "https://mindery-legal.netlify.app/privacy/",
        "TERMS_OF_SERVICE_URL": "https://mindery-legal.netlify.app/terms/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
